---
import "../styles/tokens.css";
import Footer from "../components/Footer.astro";
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>
  <body class="bg-bg text-ink font-body">
    <!-- "grid" transforme ce <div> en conteneur de grille CSS -->
    <div class="page-grid">
      <slot />
      <Footer />
    </div>
  </body>
</html>

<style>
  .page-grid {
    display: grid;
    grid-template-columns: 220px 1fr;
    /* Le hero et le contenu restent dans la colonne principale,
       tandis que la navigation occupe la hauteur des deux rangées. */
    grid-template-areas:
      "banner banner"
      "nav    hero"
      "nav    main"
      "footer footer";
    gap: 2rem;
    padding: 2rem 3rem;
  }

  /* ":global()" est nécessaire ici car StatusBanner, Sidebar, Hero, main et
     Footer ne sont pas écrits DANS ce fichier BaseLayout.astro — ce
     sont des composants externes qui arrivent via le <slot /> (ou,
     pour Footer, juste après). Par défaut, Astro n'applique le CSS
     d'un composant qu'aux balises écrites dans ce même fichier ;
     :global() dit "applique aussi à l'extérieur". */
  .page-grid :global(.status-banner) { grid-area: banner; }
  .page-grid :global(.sidebar) { grid-area: nav; }
  .page-grid :global(.hero) { grid-area: hero; }
  .page-grid :global(main) { grid-area: main; }
  .page-grid :global(.site-footer) { grid-area: footer; }

  @media (max-width: 720px) {
    .page-grid {
      grid-template-columns: 1fr;
      grid-template-areas:
        "banner"
        "hero"
        "nav"
        "main"
        "footer";
      padding: 1rem;
      gap: 1rem;
    }
  }
</style>
