---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Sidebar from "../../components/Sidebar.astro";
import Section from "../../components/Section.astro";
import TechBadge from "../../components/TechBadge.astro";
import ComingSoon from "../../components/ComingSoon.astro";
import { resolveTechs } from "../../data/technologies";

// Ce qui est réellement construit aujourd'hui
const appStack = resolveTechs([
  "astro",
  "python",
  "fastapi",
  "docker",
  "tailwind",
]);

// Ce qui est prévu par la doc du projet, pas encore construit
const plannedInfra = resolveTechs([
  "oraclecloud",
  "k3s",
  "terraform",
  "ansible",
]);
const plannedCiCd = resolveTechs(["githubactions", "argocd"]);
const plannedObservability = resolveTechs(["prometheus", "grafana"]);

const repoUrl = "https://github.com/JerKod/portfolio-app";
---

<BaseLayout title="Portfolio SRE — Technical Overview">
  <Sidebar />
  <main>
    <h1>Portfolio SRE — Technical Overview</h1>
    <p class="intro">
      This portfolio is itself an infrastructure project: a self-hosted platform
      running on a free-tier cloud, provisioned and deployed entirely as code.
      It's being built in public, in stages — here's exactly where it stands
      today.
    </p>

    <Section id="application" title="Application">
      <p>
        The site you're browsing right now: an Astro frontend and a FastAPI
        backend, developed in a fully containerized dev environment (VS Code Dev
        Containers), with no tooling installed on the host machine.
      </p>
      <div class="badge-row">
        {
          appStack.map((tech) => (
            <TechBadge name={tech.icon} label={tech.label} />
          ))
        }
      </div>
      <p class="repo-link">
        <a href={repoUrl} target="_blank" rel="noopener noreferrer">
          View the source code on GitHub →
        </a>
      </p>
    </Section>

    <Section id="infrastructure" title="Infrastructure">
      <p>
        The plan: a k3s cluster on Oracle Cloud's free tier, fully provisioned
        with Terraform and configured with Ansible — no manual server setup.
      </p>
      <div class="badge-row">
        {
          plannedInfra.map((tech) => (
            <TechBadge name={tech.icon} label={tech.label} />
          ))
        }
      </div>
    </Section>

    <Section id="ci-cd" title="CI/CD">
      <p>
        The plan: every push builds, tests, and ships a signed container image;
        Argo CD then syncs the cluster to match what's declared in Git.
      </p>
      <div class="badge-row">
        {
          plannedCiCd.map((tech) => (
            <TechBadge name={tech.icon} label={tech.label} />
          ))
        }
      </div>
    </Section>

    <Section id="observability" title="Observability">
      <p>
        The plan: Prometheus and Grafana for metrics and SLOs, with a public
        read-only dashboard linked directly from this page.
      </p>
      <ComingSoon label="Not built yet">
        <div class="badge-row">
          {
            plannedObservability.map((tech) => (
              <TechBadge name={tech.icon} label={tech.label} />
            ))
          }
        </div>
      </ComingSoon>
    </Section>
  </main>
</BaseLayout>

<style>
  .intro {
    max-width: 68ch;
    color: var(--color-slate);
  }
  .badge-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1rem;
  }
  .repo-link {
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }
  .repo-link a {
    color: var(--color-signal);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
