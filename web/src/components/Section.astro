---
const { title, id } = Astro.props;
---
<section id={id} class="block">
  <h2>{title}</h2>
  <div class="block-content">
    <slot />
  </div>
</section>

<style>
  .block {
    border-top: 1px solid var(--color-line);
    padding-top: 1.5rem;
    margin-bottom: 3rem;
  }
  .block h2 {
    font-family: var(--font-display);
    font-size: 1.5rem;
    margin: 0 0 1rem;
  }
</style>
