apiVersion: gateway.networking.k8s.io/v1
kind: Gateway
metadata:
  name: public
  namespace: default
  annotations:
    cert-manager.io/cluster-issuer: letsencrypt-prod
spec:
  gatewayClassName: traefik
  listeners:
    - name: http
      port: 8000
      protocol: HTTP
      hostname: "{{ gateway_hostname }}"
    - name: https
      port: 8443
      protocol: HTTPS
      hostname: "{{ gateway_hostname }}"
      tls:
        mode: Terminate
        certificateRefs:
          - name: jerkod-tls
